# Get these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Settings -> API -> service_role key. NEVER expose this to the client.
# Only used in server-side admin routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The Gmail address that counts as "admin" -- only this account can
# approve/reject recommendations.
ADMIN_EMAIL=you@gmail.com

# Used to build absolute redirect URLs for OAuth
NEXT_PUBLIC_SITE_URL=http://localhost:3000
